# ==================== CLASS PROCESS ====================
class MahasiswaManager:
    """Class untuk mengelola data mahasiswa"""
    
    def __init__(self):
        self.__daftar_mahasiswa = []
    
    def tambah_mahasiswa(self, mahasiswa):
        """Menambahkan mahasiswa ke daftar"""
        self.__daftar_mahasiswa.append(mahasiswa)
    
    def get_semua_mahasiswa(self):
        """Mengambil semua data mahasiswa"""
        return self.__daftar_mahasiswa
    
    def cari_mahasiswa(self, nim):
        """Mencari mahasiswa berdasarkan NIM"""
        for mhs in self.__daftar_mahasiswa:
            if mhs.get_nim() == nim:
                return mhs
        return None


class Validator:
    """Class untuk validasi input"""
    
    @staticmethod
    def validasi_nim(nim):
        """Validasi NIM harus berupa angka"""
        if not nim.isdigit():
            raise ValueError("NIM harus berupa angka!")
        if len(nim) < 5:
            raise ValueError("NIM minimal 5 digit!")
        return nim
    
    @staticmethod
    def validasi_nama(nama):
        """Validasi nama tidak boleh kosong"""
        if not nama.strip():
            raise ValueError("Nama tidak boleh kosong!")
        return nama.strip()
    
    @staticmethod
    def validasi_jurusan(jurusan):
        """Validasi jurusan tidak boleh kosong"""
        if not jurusan.strip():
            raise ValueError("Jurusan tidak boleh kosong!")
        return jurusan.strip()
    
    @staticmethod
    def validasi_ipk(ipk_str):
        """Validasi IPK harus berupa angka 0-4"""
        try:
            ipk = float(ipk_str)
            if ipk < 0 or ipk > 4:
                raise ValueError("IPK harus antara 0.00 - 4.00!")
            return ipk
        except ValueError:
            raise ValueError("IPK harus berupa angka!")


# ==================== CLASS VIEW ====================
class ViewMahasiswa:
    """Class untuk menampilkan data mahasiswa"""
    
    def tampilkan_header(self):
        """Menampilkan header program"""
        print("\n" + "="*70)
        print("PROGRAM MANAJEMEN DATA MAHASISWA".center(70))
        print("="*70)
    
    def tampilkan_menu(self):
        """Menampilkan menu pilihan"""
        print("\nMenu:")
        print("1. Tambah Data Mahasiswa")
        print("2. Tampilkan Semua Data")
        print("3. Cari Mahasiswa (berdasarkan NIM)")
        print("4. Keluar")
        print("-" * 70)
    
    def tampilkan_tabel(self, daftar_mahasiswa):
        """Menampilkan data mahasiswa dalam bentuk tabel"""
        if not daftar_mahasiswa:
            print("\nTidak ada data mahasiswa!")
            return
        
        print("\n" + "="*100)
        print(f"{'NIM':<15} {'Nama':<25} {'Jurusan':<20} {'IPK':<8} {'Predikat':<20}")
        print("="*100)
        
        for mhs in daftar_mahasiswa:
            print(f"{mhs.get_nim():<15} {mhs.get_nama():<25} {mhs.get_jurusan():<20} "
                  f"{mhs.get_ipk():<8.2f} {mhs.get_predikat():<20}")
        
        print("="*100)
    
    def tampilkan_detail_mahasiswa(self, mahasiswa):
        """Menampilkan detail satu mahasiswa"""
        if mahasiswa is None:
            print("\nData mahasiswa tidak ditemukan!")
            return
        
        print("\n" + "-"*50)
        print("DETAIL MAHASISWA")
        print("-"*50)
        print(f"NIM      : {mahasiswa.get_nim()}")
        print(f"Nama     : {mahasiswa.get_nama()}")
        print(f"Jurusan  : {mahasiswa.get_jurusan()}")
        print(f"IPK      : {mahasiswa.get_ipk():.2f}")
        print(f"Predikat : {mahasiswa.get_predikat()}")
        print("-"*50)
